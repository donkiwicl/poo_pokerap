<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.pokerap.controller.PrincipalController"
            stylesheets="@styles.css">

    <top>
        <VBox>
            <HBox styleClass="encabezado" alignment="CENTER_LEFT" spacing="12">
                <Label text="Pokerap" styleClass="titulo"/>
                <Label text="Pokédex con JSON, JavaFX y JDBC" styleClass="subtitulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblMotor" styleClass="motor"/>
            </HBox>

            <HBox styleClass="barra" alignment="CENTER_LEFT" spacing="8">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre o número" prefWidth="220"/>
                <ComboBox fx:id="cmbTipo" prefWidth="160"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Nuevo" onAction="#nuevo" styleClass="primario"/>
                <Button fx:id="btnEditar" text="Editar" onAction="#editar"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Recargar" onAction="#recargar"/>
                <Button fx:id="btnImportar" text="Importar JSON" onAction="#importar"/>
                <Button fx:id="btnDescargar" text="Descargar PokeAPI" onAction="#descargar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblPokemon">
            <placeholder>
                <Label text="No hay Pokémon que mostrar."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colNumero" text="N.°" prefWidth="60" styleClass="numerica"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="170"/>
                <TableColumn fx:id="colTipo1" text="Tipo" prefWidth="110"/>
                <TableColumn fx:id="colTipo2" text="Tipo 2" prefWidth="110"/>
                <TableColumn fx:id="colAltura" text="Altura (m)" prefWidth="90" styleClass="numerica"/>
                <TableColumn fx:id="colPeso" text="Peso (kg)" prefWidth="90" styleClass="numerica"/>
                <TableColumn fx:id="colHp" text="HP" prefWidth="65" styleClass="numerica"/>
                <TableColumn fx:id="colAtaque" text="Ataque" prefWidth="75" styleClass="numerica"/>
                <TableColumn fx:id="colDefensa" text="Defensa" prefWidth="75" styleClass="numerica"/>
                <TableColumn fx:id="colVelocidad" text="Velocidad" prefWidth="80" styleClass="numerica"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="70" styleClass="numerica"/>
            </columns>
            <BorderPane.margin>
                <Insets left="12" right="12"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <HBox styleClass="pie" alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="lblEstado" styleClass="estado" minWidth="-Infinity"/>
            <Label fx:id="lblMensaje" styleClass="mensaje"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressBar fx:id="barProgreso" prefWidth="180" progress="0" managed="${barProgreso.visible}"/>
        </HBox>
    </bottom>
</BorderPane>
